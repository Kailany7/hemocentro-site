# Notificações por e-mail via Gmail (Nodemailer)
# Passo a passo para obter o App Password:
# 1. Acesse myaccount.google.com > Segurança
# 2. Ative a verificação em duas etapas
# 3. Vá em "Senhas de app", selecione "Outro" e gere a senha
# 4. Cole a senha de 16 caracteres em GMAIL_APP_PASSWORD (sem espaços)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SITE_URL=http://localhost:5173

# Intervalo do job de notificações em ms (padrão: 15 minutos = 900000)
# NOTIFICACOES_INTERVALO_MS=900000
